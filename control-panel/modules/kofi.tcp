        ],

        onLoad(moduleConfig) {
            safeLog("[Ko-fi API] Module loaded successfully.");
            currentConfig = moduleConfig || {};

            const relayUrl = getFieldVal("relay_url") || currentConfig.relay_url || MASTER_RELAY_URL;
            if (relayUrl && relayUrl.trim()) {
                const intervalSec = Math.max(3, parseInt(getFieldVal("poll_interval") || currentConfig.poll_interval) || 5);
                safeLog(`[Ko-fi API] Polling enabled for relay: ${relayUrl} (every ${intervalSec}s)`);
                
                // Initial poll after 1s
                setTimeout(() => {
                    pollRelayServer();
                }, 1000);

                pollIntervalId = setInterval(pollRelayServer, intervalSec * 1000);
            } else {
                safeLog("[Ko-fi API] Relay URL is not configured. Ready for manual testing or relay setup.");
            }

            // HUD update ticker
            hudIntervalId = setInterval(updateKofiHUD, 3000);
            setTimeout(updateKofiHUD, 500);
        },

        onUnload() {
            safeLog("[Ko-fi API] Module unloaded.");
            if (pollIntervalId) {
                clearInterval(pollIntervalId);
                pollIntervalId = null;
            }
            if (hudIntervalId) {
                clearInterval(hudIntervalId);
                hudIntervalId = null;
            }

            const hudDiv = document.getElementById("kofi-status-hud");
            if (hudDiv && hudDiv.parentNode) {
                hudDiv.parentNode.removeChild(hudDiv);
            }
        },

        copyWebhookUrl() {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(MASTER_RELAY_URL).then(() => {
                    safeLog("[Ko-fi API] Copied Webhook Relay URL to clipboard!");
                    alert(`Copied Webhook URL to clipboard!\n\n${MASTER_RELAY_URL}\n\nPaste this into your Ko-fi settings at:\nhttps://ko-fi.com/manage/webhooks`);
                }).catch(() => {
                    prompt("Copy your Webhook Relay URL:", MASTER_RELAY_URL);
                });
            } else {
                prompt("Copy your Webhook Relay URL:", MASTER_RELAY_URL);
            }
        },

        openKofiWebhooks() {
            const url = "https://ko-fi.com/manage/webhooks";
            safeLog("[Ko-fi API] Opening Ko-fi Webhook Settings in default browser...");
            if (window.__TAURI__ && window.__TAURI__.core && window.__TAURI__.core.invoke) {
                window.__TAURI__.core.invoke('run_external_command', {
                    program: "cmd.exe",
                    args: ["/c", "start", "", url]
                }).catch(() => {
                    window.open(url, "_blank");
                });
            } else {
                window.open(url, "_blank");
            }
        },

        // External push endpoint for local webhooks or direct integrations
        handleWebhookPayload(payload) {
            processIncomingKofiEvent(payload, false);
        }
    };

    // Register Context Provider
    window.TheaterController.registerContextProvider("kofi_stats_provider", 
        async () => {
            const currencySymbol = getFieldVal("currency_symbol") || currentConfig.currency_symbol || "$";
            return {
                kofi_latest_supporter: stats.latest_supporter || "None",
                kofi_latest_amount: stats.latest_amount || "$0.00",
                kofi_latest_raw_amount: (stats.total_amount_cents / 100),
                kofi_latest_message: stats.latest_message || "",
                kofi_latest_type: stats.latest_type || "None",
                kofi_latest_tier: stats.latest_tier || "",
                kofi_session_total_amount: formatCurrency(stats.total_amount_cents, currencySymbol),
                kofi_session_total_cents: stats.total_amount_cents,
                kofi_session_donation_count: stats.total_donations,
                kofi_session_sub_count: stats.total_subscriptions,
                kofi_session_shop_count: stats.total_shop_orders,
                kofi_session_commission_count: stats.total_commissions,
                kofi_session_total_events: stats.total_events,
                kofi_recent_supporters: stats.recent_supporters.join(", ") || "None"
            };
        },
        {
            label: "Ko-fi: Creator & Session Statistics",
            samplePayload: {
                kofi_latest_supporter: "CoffeeLover99",
                kofi_latest_amount: "$5.00",
                kofi_latest_raw_amount: 5,
                kofi_latest_message: "Love the streams!",
                kofi_latest_type: "Donation",
                kofi_latest_tier: "",
                kofi_session_total_amount: "$50.00",
                kofi_session_total_cents: 5000,
                kofi_session_donation_count: 5,
                kofi_session_sub_count: 1,
                kofi_session_shop_count: 1,
                kofi_session_commission_count: 0,
                kofi_session_total_events: 7,
                kofi_recent_supporters: "CoffeeLover99, GoldSupporter, ArtFanatic"
            }
        },
        MODULE_ID
    );

    // Register Custom Trigger
    window.TheaterController.registerTrigger("kofi_event", 
        (t, eventData) => {
            // Event Type Filter
            if (t.eventType && t.eventType !== "all" && t.eventType !== eventData.eventType) {
                return false;
            }

            // Minimum Amount Filter
            if (t.minAmount && parseFloat(t.minAmount) > 0) {
                const minCents = Math.round(parseFloat(t.minAmount) * 100);
                if (eventData.amountCents < minCents) {
                    return false;
                }
            }

            // Tier Name Filter (for subscriptions)
            if (t.tierFilter && t.tierFilter.trim()) {
                const requiredTier = t.tierFilter.trim().toLowerCase();
                const actualTier = (eventData.tierName || "").toLowerCase();
                if (!actualTier.includes(requiredTier)) {
                    return false;
                }
            }

            // Public Only Filter
            if (t.publicOnly && !eventData.isPublic) {
                return false;
            }

            return true;
        },
        {
            label: "Ko-fi Event",
            fields: [
                { 
                    id: "eventType", 
                    label: "Event Type", 
                    type: "select", 
                    options: [
                        { value: "all", label: "Any Ko-fi Event (All Types)" },
                        { value: "Donation", label: "Donation (One-time Tip / Coffee)" },
                        { value: "Subscription", label: "Subscription (Monthly Membership)" },
                        { value: "Shop Order", label: "Shop Order (Physical/Digital Item)" },
                        { value: "Commission", label: "Commission (Custom Order)" }
                    ],
                    default: "all"
                },
                { 
                    id: "minAmount", 
                    label: "Minimum Amount Filter (Optional, e.g. 5.00)", 
                    type: "number", 
                    default: 0 
                },
                {
                    id: "tierFilter",
                    label: "Membership Tier Match (Optional filter for Subscriptions)",
                    type: "text",
                    default: ""
                }
            ]
        }, 
        MODULE_ID
    );

    window.TheaterController.registerModule(MODULE_ID, MODULE_DEFINITION);
})();
